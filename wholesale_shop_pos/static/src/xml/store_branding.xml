<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wholesale_shop_pos.StoreSessionExpired" t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">Session Expired</attribute>
        </xpath>
        <xpath expr="//p" position="replace"><p>Your session expired. This page will refresh.</p></xpath>
    </t>
    <t t-name="wholesale_shop_pos.StoreEdition" t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace"><h3 class="px-0">Wholesale Shop</h3></xpath>
        <xpath expr="//small" position="replace">
            <small><a href="https://www.gnu.org/licenses/lgpl.html" target="_blank" rel="noopener">GNU LGPL Licensed</a></small>
        </xpath>
    </t>
</templates>
