<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wholesale_shop_pos.BillCameraField">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <t t-call="web.BinaryField"/>
            <t t-if="!props.readonly">
                <button type="button" class="btn btn-secondary text-nowrap" t-on-click="takePhoto">
                    <i class="fa fa-camera me-1"/>Take a photo
                </button>
                <input type="file" class="d-none" accept="image/*" capture="environment"
                       t-ref="cameraInput" t-on-change="onCameraFile"/>
            </t>
        </div>
    </t>
    <t t-name="wholesale_shop_pos.BillCameraDialog">
        <Dialog title="title" size="'lg'">
            <div t-if="state.error" class="alert alert-warning" role="alert" t-esc="state.error"/>
            <p>Position the bill so the text is clear, then capture the photo.</p>
            <video t-ref="video" autoplay="autoplay" playsinline="playsinline" muted="muted"
                   class="w-100 rounded" style="max-height: 65vh; background: #111;"
                   t-on-loadeddata="onReady"/>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="capture"
                        t-att-disabled="!state.ready || state.saving">
                    <i class="fa fa-camera me-1"/>Capture photo
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
