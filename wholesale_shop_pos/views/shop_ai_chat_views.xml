<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_ai_chat_list" model="ir.ui.view">
        <field name="name">shop.ai.chat.list</field>
        <field name="model">shop.ai.chat</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="write_date"/></list>
        </field>
    </record>
    <record id="view_shop_ai_chat_form" model="ir.ui.view">
        <field name="name">shop.ai.chat.form</field>
        <field name="model">shop.ai.chat</field>
        <field name="arch" type="xml">
            <form string="Shop AI Chat">
                <header>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <field name="user_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="message_ids" nolabel="1">
                        <kanban create="0" delete="0" quick_create="0">
                            <templates>
                                <t t-name="card">
                                    <div class="p-3 border rounded mb-2">
                                        <strong><field name="role"/></strong>
                                        <div class="mt-2" style="white-space: pre-wrap"><field name="content"/></div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <group>
                        <field name="prompt" placeholder="Ask about products, stock, purchases, invoices, or POS records..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_shop_ai_chat" model="ir.actions.act_window">
        <field name="name">AI Chat</field>
        <field name="res_model">shop.ai.chat</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>
</odoo>
