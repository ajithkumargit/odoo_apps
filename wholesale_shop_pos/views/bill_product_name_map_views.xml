<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_bill_product_name_map_list" model="ir.ui.view">
        <field name="name">shop.bill.product.name.map.list</field>
        <field name="model">shop.bill.product.name.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="bill_product_name"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shop_bill_product_name_map_form" model="ir.ui.view">
        <field name="name">shop.bill.product.name.map.form</field>
        <field name="model">shop.bill.product.name.map</field>
        <field name="arch" type="xml">
            <form string="Bill Name to Product">
                <sheet>
                    <group>
                        <field name="bill_product_name"/>
                        <field name="product_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_bill_product_name_map" model="ir.actions.act_window">
        <field name="name">Bill Name → Product</field>
        <field name="res_model">shop.bill.product.name.map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a short product name from a bill to its actual Odoo product.</p>
            <p>The same bill name will be matched automatically on future bills.</p>
        </field>
    </record>
</odoo>
