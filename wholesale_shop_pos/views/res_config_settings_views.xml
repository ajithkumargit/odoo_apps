<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wholesale.shop.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Wholesale Shop" string="Wholesale Shop" name="wholesale_shop_pos"
                     groups="base.group_system">
                    <block title="Product Photos" name="wholesale_product_photos">
                        <setting id="shop_product_image_search" string="Google image results"
                                 help="Optional: add your SerpAPI key to display up to five Google image thumbnails in the product photo popup. Without a key, open Google Images and upload your selected photo. Searches use your SerpAPI quota.">
                            <field name="shop_serpapi_key" password="True" placeholder="Optional SerpAPI key"/>
                        </setting>
                    </block>
                    <block title="AI Chat" name="wholesale_ai_chat">
                        <setting id="shop_ai_api_key" string="OpenAI connection"
                                 help="Enter your OpenAI API key to enable AI Chat. Messages and selected Odoo record details are sent to OpenAI. The server-side key is never sent to browser JavaScript. Alternatively set OPENAI_API_KEY in the Odoo service environment.">
                            <field name="shop_ai_api_key" password="True" placeholder="OpenAI API key"/>
                            <field name="shop_ai_model" placeholder="gpt-4.1-mini"/>
                        </setting>
                    </block>
                    <block title="Public Access" name="wholesale_public_access">
                        <setting id="shop_public_database_tools" string="Public database tools"
                                 help="Off: only a signed-in Settings administrator can use database manager, selector, list, backup and other database endpoints. The server's dbfilter and list_db settings may further restrict them.">
                            <field name="shop_allow_public_database_tools"/>
                        </setting>
                        <setting id="shop_public_signup" string="Public self-signup"
                                 help="Off: visitors cannot create their own account. Invitation links continue to work.">
                            <field name="shop_allow_public_signup"/>
                        </setting>
                        <setting id="shop_public_password_reset" string="Public password reset"
                                 help="Off: visitors cannot request a password reset from the login page. Administrators can manage users in Settings.">
                            <field name="shop_allow_public_password_reset"/>
                        </setting>
                    </block>
                    <block title="Weight Pricing" name="wholesale_weight_pricing">
                        <setting id="shop_weight_options" string="Default weight options"
                                 help="Comma-separated weights used by Load Configured Weights on products. Existing variants are preserved. Any positive gram or kilogram weight is supported.">
                            <field name="shop_weight_options" placeholder="100g,200g,250g,500g,750g,1kg"/>
                        </setting>
                    </block>
                    <block title="Local Supplier Bill Extraction" name="wholesale_bill_extraction">
                        <setting id="wholesale_local_ocr"
                                 string="Offline OCR enabled"
                                 help="Supplier bill images are processed locally by PaddleOCR with Tesseract fallback, while Fitz/PyMuPDF handles PDFs. No API key is needed and bill files are not sent externally.">
                            <div class="text-muted">
                                Uses local Tamil/English OCR, manual image cropping, and coordinate-based table reconstruction.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
