<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_weight_pricing_common" model="ir.ui.view">
        <field name="name">product.template.weight.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group string="Weight Pricing" name="shop_weight_pricing">
                    <field name="shop_price_by_weight"/>
                    <field name="shop_weight_attribute_id" required="shop_price_by_weight"
                           domain="[('create_variant', '!=', 'no_variant')]" options="{'no_create': True}"/>
                    <div colspan="2" invisible="not shop_weight_attribute_id">
                        <button name="action_load_shop_weight_options" type="object" string="Load Configured Weights"
                                class="btn-secondary"/>
                    </div>
                    <field name="shop_bulk_stock_product_id" invisible="not shop_price_by_weight" options="{'no_create': True}"/>
                    <field name="shop_cost_per_kg" invisible="not shop_price_by_weight"/>
                    <div colspan="2"><button name="action_update_cost_from_bill" type="object" string="Update Cost from Bill" class="btn-secondary"/></div>
                    <field name="shop_sale_price_per_kg" invisible="not shop_price_by_weight"/>
                    <div colspan="2" class="text-muted" invisible="not shop_price_by_weight">
                        Add weights under Attributes &amp; Variants, using names such as 100g, 250g, 500g, 750g or 1kg.
                        With kg as the unit, cost and price stay per kg; selecting a weight in POS sets its kg quantity (250g = 0.25 kg).
                        With Units, each variant is one pack and cost and price are the kg amount × grams ÷ 1000.
                        Changing Cost / kg updates costs for each weight. When Profit % is positive, it also recalculates selling prices; with zero Profit %, selling prices stay unchanged.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_template_weight_price_labels" model="ir.ui.view">
        <field name="name">product.template.weight.price.labels</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="wholesale_shop_pos.view_product_template_form_profit_wholesale_shop"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="invisible">type == 'combo' or (not shop_price_by_weight and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">type == 'combo' or (not shop_price_by_weight and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']/span" position="attributes">
                <attribute name="invisible">shop_price_by_weight</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']/span" position="after">
                <span invisible="not shop_price_by_weight">per kg</span>
            </xpath>
            <xpath expr="//field[@name='shop_profit_percent']" position="attributes">
                <attribute name="invisible">product_variant_count &gt; 1 and not shop_price_by_weight</attribute>
            </xpath>
            <xpath expr="//div[@name='list_price_uom']" position="attributes"><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//label[@for='list_price']" position="attributes"><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes"><attribute name="readonly">False</attribute></xpath>
        </field>
    </record>
    <record id="view_variant_weight_prices" model="ir.ui.view">
        <field name="name">product.product.weight.prices</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="wholesale_shop_pos.view_product_product_form_wholesale_shop"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shop_bulk_stock_product_id']" position="attributes">
                <attribute name="domain">[('product_tmpl_id', '=', product_tmpl_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='shop_mrp']" position="before">
                <field name="shop_variant_weight_grams" invisible="not shop_price_by_weight"/>
            </xpath>
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group string="Selected Weight Amounts" invisible="not shop_price_by_weight">
                    <field name="shop_variant_weight_grams" string="Selected Weight (g)"/>
                    <field name="shop_weight_sale_amount"/>
                    <field name="shop_weight_cost_amount"/>
                    <field name="shop_weight_profit_percent"/>
                    <div colspan="2" class="text-muted">Editing the selected weight's sales price, Profit %, or applying Price to Check updates the shared kg rate and all weights of this product.</div>
                    <div colspan="2" class="text-muted">These amounts are for the selected weight. The unit prices above remain per kg for loose-weight products.</div>
                </group>
            </xpath>
            <xpath expr="//label[@for='lst_price']" position="attributes"><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//div[@name='list_price_uom']" position="attributes"><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="shop_weight_sale_amount" string="Sales Price (Selected Weight)" invisible="not shop_price_by_weight"/>
            </xpath>
            <xpath expr="//field[@name='shop_variant_sale_price']" position="attributes"><attribute name="readonly">False</attribute><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes"><attribute name="readonly">False</attribute></xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes"><attribute name="readonly">False</attribute></xpath>
            <xpath expr="//field[@name='shop_variant_profit_percent']" position="attributes"><attribute name="invisible">shop_price_by_weight</attribute></xpath>
            <xpath expr="//field[@name='shop_variant_price_check']" position="attributes"><attribute name="invisible">False</attribute></xpath>
            <xpath expr="//button[@name='action_apply_shop_variant_checked_profit']" position="attributes">
                <attribute name="invisible">not shop_variant_price_check</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_weight_attribute_values" model="ir.ui.view">
        <field name="name">product.attribute.weight.values</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="shop_weight_grams" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="view_weight_variant_list" model="ir.ui.view">
        <field name="name">product.product.weight.list</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="before">
                <field name="shop_price_by_weight" column_invisible="True"/>
                <field name="shop_variant_weight_grams" optional="hide"/>
                <field name="shop_weight_sale_amount" optional="show" invisible="not shop_price_by_weight"/>
                <field name="shop_weight_cost_amount" optional="show" invisible="not shop_price_by_weight"/>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes"><attribute name="readonly">False</attribute></xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes"><attribute name="readonly">False</attribute></xpath>
        </field>
    </record>
    <record id="view_weight_variant_easy_edit" model="ir.ui.view">
        <field name="name">product.product.weight.easy.edit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="before">
                <field name="shop_price_by_weight" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']/.." position="after">
                <field name="shop_variant_weight_grams" invisible="not shop_price_by_weight"/>
                <field name="shop_weight_sale_amount" invisible="not shop_price_by_weight"/>
                <field name="shop_weight_cost_amount" invisible="not shop_price_by_weight"/>
                <field name="shop_cost_per_kg" invisible="not shop_price_by_weight"/>
                    <div colspan="2"><button name="action_update_cost_from_bill" type="object" string="Update Cost from Bill" class="btn-secondary"/></div>
                <field name="shop_sale_price_per_kg" invisible="not shop_price_by_weight"/>
            </xpath>
        </field>
    </record>
</odoo>
