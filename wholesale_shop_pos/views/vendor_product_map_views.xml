<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_vendor_product_map_list" model="ir.ui.view">
        <field name="name">shop.vendor.product.map.list</field>
        <field name="model">shop.vendor.product.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id" context="{'default_shop_is_vendor': True}"/>
                <field name="vendor_product_name"/>
                <field name="vendor_product_code"/>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shop_vendor_product_map_form" model="ir.ui.view">
        <field name="name">shop.vendor.product.map.form</field>
        <field name="model">shop.vendor.product.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id"
                               widget="res_partner_many2one"
                               context="{'default_shop_is_vendor': True, 'show_vat': True}"
                               placeholder="Name, TIN, Email, or Reference"/>
                        <field name="vendor_product_name"/>
                        <field name="vendor_product_code"/>
                        <field name="barcode"/>
                        <field name="product_id"/>
                        <field name="active"/>
                    </group>
                    <field name="note" placeholder="Optional vendor-specific notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_vendor_product_map" model="ir.actions.act_window">
        <field name="name">Vendor Product Mappings</field>
        <field name="res_model">shop.vendor.product.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
