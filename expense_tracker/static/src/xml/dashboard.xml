<templates xml:space="preserve">

<t t-name="expense_tracker.FinanceDashboard">

<div class="container-fluid p-3">

    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-3">

                <!-- Chart Type -->

                <div class="col-md-3">

                    <label class="form-label">
                        Chart Type
                    </label>

                    <select
                        class="form-select"
                        t-on-change="onChartTypeChange">

                        <option value="line">Line</option>
                        <option value="bar">Bar</option>
                        <option value="pie">Pie</option>
                        <option value="doughnut">Doughnut</option>
                        <option value="radar">Radar</option>
                        <option value="polarArea">Polar Area</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Transaction Type    
                    </label>
                <MultiSelect
                    groups="[{
                        id: 1,
                        name: 'Transaction Type',
                        children: state.types
                    }]"
                    selected="state.selectedTypes"
                    placeholder="'Transaction Type'"
                    onChange.bind="onTypeSelected"/>
                </div>
                <!-- X Axis -->

                <div class="col-md-3">

                    <label class="form-label">
                        X Axis
                    </label>

                    <select
                        class="form-select"
                        t-on-change="onXAxisChange">

                        <option value="transaction_datetime:month">
                            Month
                        </option>

                        <option value="transaction_datetime:year">
                            Year
                        </option>

                        <option value="category_id">
                            Category
                        </option>

                        <option value="subcategory_id">
                            Sub Category
                        </option>

                    </select>

                </div>

                <!-- Accounts -->

                <div class="col-md-3">

                    <label class="form-label">
                        Accounts
                    </label>

                    <select
                        multiple="multiple"
                        class="form-select"
                        style="height:30px"
                        t-on-change="onAccountChange">

                        <t
                            t-foreach="state.accounts || []"
                            t-as="account"
                            t-key="account.id">

                            <option
                                t-att-value="account.id">

                                <t t-esc="account.bankname"/>

                            </option>

                        </t>

                    </select>

                </div>

            </div>

            <!-- Categories -->

            <div class="mt-3">

                <label class="form-label">
                    Categories
                </label>
                <MultiSelect
                    groups="state.categoryGroups"
                    selected="state.selectedCategories"
                    placeholder="'Select Categories'"
                    onChange.bind="onCategorySelected"/>

            </div>

        </div>

    </div>

    <!-- Chart -->

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Finance Analytics</strong>
        </div>

        <div class="card-body">

            <div style="height:600px;position:relative;">

                <canvas id="financeChart"></canvas>

            </div>

        </div>

    </div>

</div>

</t>

</templates>