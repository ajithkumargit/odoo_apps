<?xml version="1.0" encoding="utf-8"?>
<odoo>    
    <record id="excel_data_tree_view" model="ir.ui.view">
        <field name="name">excel.data.tree.view</field>
        <field name="model">excel.data</field>
        <field name="arch" type="xml">
            <list>
            <field name="name"/>
            <field name="file"/>
            <field name="file_type"/>
            </list>
        </field>
    </record>

    <record id="excel_customize_action_view" model="ir.actions.act_window">
            <field name="name">Excel Customize</field>
            <field name="res_model">excel.data</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="excel_data_tree_view"/>
    </record>
    <menuitem
        id="menu_excel_data"
        name="Excel Data"
        
        sequence="10"/>

     <menuitem
        id="menu_sub_excel_data"
        name="Excel Data"
        parent="menu_excel_data"
        action="excel_customize_action_view"
        sequence="10"/>
</odoo>
